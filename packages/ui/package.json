{
  "name": "@nge/ui",
  "version": "0.5.0-beta.3",
  "description": "Isolated default UI components for the Next-Gen Editor SDK. Pure CSS namespaced under `.nge-*`. Zero Tailwind. Zero Shadcn. Zero external component libraries.",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": ["src"],
  "scripts": {
    "tsc": "tsc --noEmit"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "@nge/core": "workspace:*"
  },
  "devDependencies": {
    "@nge/core": "workspace:*",
    "solid-js": "^1.9.13",
    "typescript": "^5.9.3"
  }
}
