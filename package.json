{
  "name": "next-gen-editor-monorepo",
  "version": "0.5.0-beta.3",
  "private": true,
  "workspaces": [
    "packages/*",
    "ts",
    "tools/*"
  ],
  "scripts": {
    "dev": "pnpm --filter next-gen-editor-ui dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter next-gen-editor-ui build",
    "tsc": "pnpm -r tsc"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.5.0 <12"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "vitest": "5.0.3"
  }
}
