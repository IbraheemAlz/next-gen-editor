{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(cargo *)",
      "Bash(rustup *)",
      "Bash(rustc --version)",
      "Bash(rustfmt *)",
      "Bash(wasm-pack *)",
      "Bash(wasm-opt *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(gh issue *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh repo view*)",
      "Bash(gh api *)",
      "Bash(gh label list*)",
      "Bash(gh label create *)",
      "Bash(brew install wasm-pack)",
      "Bash(brew install *)",
      "Bash(git status*)",
      "Bash(git status --short*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit -m*)",
      "Bash(git commit --message*)",
      "Bash(git rev-parse*)",
      "Bash(git init*)",
      "Bash(git ls-files*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(pgrep *)",
      "Bash(pkill *)",
      "Bash(curl -sI*)",
      "Bash(curl -s http://localhost*)",
      "Bash(identify *)",
      "Bash(convert *)",
      "Bash(file *)",
      "Bash(ls *)",
      "Bash(ls -*)",
      "Bash(find *)",
      "Bash(mkdir -p*)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(wc *)",
      "Bash(xxd *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(google-chrome --headless* http://localhost*)",
      "Bash(fc-list*)",
      "Bash(fc-match*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git config*)",
      "Bash(sudo *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  },
  "env": {
    "RUST_BACKTRACE": "1",
    "CARGO_TERM_COLOR": "always"
  }
}
